{
  "opencollection": "1.0.0",
  "info": {
    "name": "GoalServe Sports Data Feeds Commentaries Player Data API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Player Data",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Player profile and statistics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.goalserve.com/getfeed/:key/soccerstats/player/:player_id",
            "params": [
              {
                "name": "key",
                "value": "",
                "type": "path",
                "description": "GoalServe API access key path segment."
              },
              {
                "name": "player_id",
                "value": "",
                "type": "path",
                "description": "Player identifier."
              },
              {
                "name": "json",
                "value": "",
                "type": "query",
                "description": "Set to `1` to receive the feed as JSON instead of the default XML."
              }
            ]
          },
          "docs": "Returns the profile, biography and statistics for a single player."
        }
      ]
    }
  ],
  "bundled": true
}